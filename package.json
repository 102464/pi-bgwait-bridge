{
  "name": "pi-bgwait-bridge",
  "version": "0.1.0",
  "description": "Bridge pi-background-tasks native background work into pi-subagents bg_wait, plus a unified wait tool for exact background task ids.",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/bgwait-bridge.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "test",
    "scripts",
    "evidence",
    "README.md",
    "AGENTS.md",
    "COMPATIBILITY.md",
    "SOURCE-AUDIT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "live-e2e": "node scripts/live-e2e.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^26.6.6",
    "pi-subagents": "^0.89.2",
    "typescript": "^7.0.2"
  }
}
