{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src/**/*.ts",
    "extensions/**/*.ts",
    "test/**/*.ts"
  ]
}
