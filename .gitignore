# Build / test artifacts — not source.

node_modules/
*.tgz

# Pi session + background-task state (per-machine, never portable).
.pi/

# Live-E2E and unit-test output. `evidence/` is produced locally by the commands
# COMPATIBILITY.md names next to each claim; a run log is a per-machine
# observation, so it is never committed. Re-run the listed command to check the
# claim on your machine.
evidence/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# `> nul` under MSYS lands as a real file named `nul` (the cmd.exe null device cannot
# be opened as a path there). The live probes redirect to it, so it keeps reappearing;
# it is an artifact, never source.
nul
